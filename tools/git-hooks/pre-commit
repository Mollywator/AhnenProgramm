#!/bin/sh
#
# Refuse any commit that carries family data.
#
# The separation is what protects the family: the trees, the report and the
# portraits live in a folder of their own, beside this one, and what is not
# here cannot be committed from here. `.gitignore` keeps the old paths out on
# top of that. This hook is the third lock, and it checks what is actually
# staged rather than what should have been ignored - one `git add -f`, one
# edited ignore line, one folder nobody thought of, and a pushed commit cannot
# be taken back.
#
# It asks about paths, not about content. Whether a real name sits inside a
# line of code is a question this hook deliberately no longer asks. The rule is
# simply that no name gets typed into the program: everything that names a
# person is data, and data lives in the other folder. A name that turns up here
# anyway is one somebody wrote on purpose and had a reason for.
#
# Installed by tools/git-hooks/install.sh - .git/hooks is not versioned, so a
# fresh clone has to install it again.

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

bad=""

for path in $staged; do
    case "$path" in
        data/*|source/*|Stammbaum-Daten/*|Export/*|Release/*|.claude/*)
            bad="$bad\n  $path   (Ordner mit Familiendaten)" ;;
        tools/report.json)
            bad="$bad\n  $path   (die einzige Datei mit Namen)" ;;
        Stammbaum.html|*.exe)
            bad="$bad\n  $path   (gebaute Fassung mit Daten darin)" ;;
        *.jpg|*.jpeg|*.png|*.pdf|*.ged|*.baum)
            bad="$bad\n  $path   (Portrait, Bericht oder Baumdatei)" ;;
        *.pyc|*__pycache__*)
            bad="$bad\n  $path   (Python-Zwischenstand, kein Quelltext)" ;;
    esac
done

if [ -n "$bad" ]; then
    printf '\nCOMMIT ABGEBROCHEN - hier stehen Familiendaten im Staging:\n'
    printf "$bad\n"
    printf '\nDiese Daten gehoeren nur auf diesen Rechner und in die Serversicherung.\n'
    printf 'Nimm sie mit "git restore --staged <datei>" wieder heraus.\n\n'
    exit 1
fi

exit 0
